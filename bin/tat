#!/bin/sh
#
# Attach or create tmux session in the directory of arg 1 or select via fzf
# from a list of git initialized directories.
#
# ENV configuration:
#
# TAT_SEARCH_PATH -- Where to search for the directories
# TAT_PINNED_FILE -- File of directories (one path per line) to list first. Blank lines and lines starting with '#' are ignored.

DEFAULT_SEARCH_PATH="$HOME/Coding"
DEFAULT_PINNED_FILE="$HOME/.config/tat/dirs"

if [ $# -eq 1 ]; then
    selected=$1
else
    search_path="${TAT_SEARCH_PATH:-$DEFAULT_SEARCH_PATH}"
    pinned_file="${TAT_PINNED_FILE:-$DEFAULT_PINNED_FILE}"

    selected=$(
      {
        [ -f "$pinned_file" ] && cat "$pinned_file"
        find "$search_path" \
          -mindepth 1 \
          -maxdepth 2 \
          -type d
      } \
        | awk 'NF && $0 !~ /^[[:space:]]*#/ && !seen[$0]++' \
        | fzf
    )
fi

if [ -z "$selected" ]; then
    exit 0
fi

session_name=$(basename "$selected" | tr . _)

not_in_tmux() {
  [ -z "$TMUX" ]
}

session_exists() {
  tmux has-session -t "=$session_name"
}

create_detached_session() {
  (TMUX='' tmux new-session -Ad -s "$session_name" -c "$selected")
}

create_if_needed_and_attach() {
  if not_in_tmux; then
    tmux new-session -As "$session_name" -c "$selected"
  else
    if ! session_exists; then
      create_detached_session
    fi
    tmux switch-client -t "$session_name"
  fi
}

create_if_needed_and_attach
